--!strict

local fs = require("@std/fs")
local process = require("@std/process")

local BLINK_VERSION = "1.0.0-pre.8"
local BLINK_SCHEMA = "src/shared/Network/main.blink"
local BLINK_STAMP = "src/shared/Network/main.blink.stamp"
local BLINK_GENERATED = {
	"src/shared/Network/Types.luau",
	"src/shared/Network/Client.luau",
	"src/shared/Network/Server.luau",
}
local HASH_MODULUS = 4294967296

local function fail(message: string, exitCode: number?): never
	print(string.format("[generate-blink] FAILED: %s", message))
	process.exit(if exitCode ~= nil and exitCode ~= 0 then exitCode else 1)
	error("process.exit returned unexpectedly")
end

local function fingerprint(source: string): string
	local hash = 5381
	for index = 1, #source do
		hash = (hash * 33 + string.byte(source, index)) % HASH_MODULUS
	end
	return string.format("%08x", hash)
end

if not fs.exists(BLINK_SCHEMA) or not fs.exists("rokit.toml") then
	fail("run this command from the repository root")
end

print(string.format("[generate-blink] Compile %s with Blink %s", BLINK_SCHEMA, BLINK_VERSION))
local result = process.run({ "blink", "compile", "--profile", "release", BLINK_SCHEMA }, { stdio = "inherit" })
if not result.ok then
	fail("Blink compilation failed", result.exitcode)
end

local blinkHeader = "--file generated by blink " .. BLINK_VERSION
local generatedContents: { string } = {}
for index, path in BLINK_GENERATED do
	if not fs.exists(path) then
		fail(string.format("Blink did not generate %s", path))
	end
	local source = fs.readFileToString(path)
	if string.find(source, blinkHeader, 1, true) == nil then
		fail(string.format("%s was not generated by Blink %s", path, BLINK_VERSION))
	end
	generatedContents[index] = source
end

local stamp = table.concat({
	"blink_version=" .. BLINK_VERSION,
	"schema_djb2=" .. fingerprint(fs.readFileToString(BLINK_SCHEMA)),
	"types_djb2=" .. fingerprint(generatedContents[1]),
	"client_djb2=" .. fingerprint(generatedContents[2]),
	"server_djb2=" .. fingerprint(generatedContents[3]),
}, "\n") .. "\n"
fs.writeStringToFile(BLINK_STAMP, stamp)

print(string.format("[generate-blink] Updated %s and generated modules", BLINK_STAMP))
